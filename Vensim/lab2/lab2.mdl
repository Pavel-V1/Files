{UTF-8}
Разработанное программное обеспечение= INTEG (
	скорость разработки ИС,
		0)
	~	 [0,500]
	~		|

скорость разработки ИС=
	IF THEN ELSE(Требования к ИС > 0, 2, 0)
	~	 [0,?]
	~		|

Требования к ИС= INTEG (
	-скорость разработки ИС,
		500)
	~	 [0,500]
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 500
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Day [0,?]
	~	The time step for the simulation.
	|


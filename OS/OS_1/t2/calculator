#!/bin/bash

a=$1
op=$2
b=$3

if [ $# -ne 3 ] && [ $# -ne 0 ]
then
	echo "Передайте аргументы в формате <число> <операция> <число>"
	exit 1
fi

case "$op" in
	+)
		echo "$(expr $a + $b)"
		;;
	-)
		echo "$(expr $a - $b)"
		;;
	\*)
		echo "$(expr $a \* $b)"
		;;
	/)
		if [ $b -ne 0 ]
		then
			echo "$(expr $a / $b)"
		else
			echo "Ошибка: на ноль делить нельзя"
		fi
		;;
	*)
		echo "Поддерживаемые операции: '+', '-', '\*', '/'"
		;;
esac

#!/bin/bash

while [ -n "$1" ]
do
	case "$1" in
	-n)
		n="$2"
		if [ -z "$n" ]
		then
			n=1
		fi
		shift 2
		;;
	-t)
		t="$2"
		if [ -z "$t" ]
		then
			t=0
		fi
		shift 2
		;;
	--)
		if ! text="$2"
		then
			echo "Передайте текст для вывода"
			exit 1
		fi
		;;
	*)
		echo "Передайте арггументы в формате "\
"'-n <число выводов текста> -t <таймаут вывода> -- <текст>'"
		exit 1
		;;
	esac
done


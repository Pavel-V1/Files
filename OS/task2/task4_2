#!/bin/bash

like_find() {
	n=$(expr $2 + 1)
        for file in "$1"/*
        do
                if [ -d $file ]
                then
                        echo "$n) $file"
			like_find "$file" "$n"
                else
                        echo "$n) $file"
                fi
        done
}

if [ $# -eq 0 ]
then
        echo $(like_find '.' 0)
else
        echo $(like_find $1 0)
fi
